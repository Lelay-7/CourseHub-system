# Copy this file to .env.local and replace every placeholder. Never commit real secrets.
DB_URL=jdbc:mysql://127.0.0.1:3306/bgss_xtt?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace-with-mysql-user
DB_PASSWORD=replace-with-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
SMS_MOCK=true
SMS_MOCK_CODE=123456
FILE_UPLOAD_PATH=./uploads
FILE_MAX_SIZE=50MB
FILE_MAX_REQUEST_SIZE=55MB
APP_LOG_LEVEL=INFO
REDIS_SERVER_PATH=
