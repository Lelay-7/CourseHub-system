<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bugaoshan.mapper.ChatMessageMapper">
 <select id="idempotent" resultType="com.bugaoshan.entity.ChatMessage">SELECT * FROM chat_message WHERE sender_id=#{userId} AND client_message_id=#{clientId}</select>
 <insert id="insert" useGeneratedKeys="true" keyProperty="messageId">INSERT INTO chat_message(conversation_id,sequence,sender_id,client_message_id,message_type,content,created_at) VALUES(#{conversationId},#{sequence},#{senderId},#{clientMessageId},#{messageType},#{content},#{createdAt})</insert>
 <update id="advance">UPDATE chat_conversation SET last_sequence=#{sequence},last_message_at=#{now},updated_at=#{now} WHERE conversation_id=#{id}</update>
 <select id="page" resultType="com.bugaoshan.entity.ChatMessage">
  SELECT * FROM chat_message WHERE conversation_id=#{id}
  <if test="before != null">AND sequence&lt;#{before}</if>
  <if test="after != null">AND sequence&gt;#{after}</if>
  ORDER BY sequence <choose><when test="after != null">ASC</when><otherwise>DESC</otherwise></choose> LIMIT #{limit}
 </select>
</mapper>
