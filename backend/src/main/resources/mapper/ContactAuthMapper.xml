<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bugaoshan.mapper.ContactAuthMapper">

    <select id="selectByUserId" resultType="com.bugaoshan.entity.ContactAuth">
        SELECT * FROM contact_auth WHERE user_id = #{userId}
    </select>

    <update id="updateAuth">
        UPDATE contact_auth
        SET phone_visible = #{phoneVisible},
            email_visible = #{emailVisible},
            contact_visible = #{contactVisible},
            update_time = NOW()
        WHERE auth_id = #{authId}
    </update>

</mapper>
